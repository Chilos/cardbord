{
  "name": "logseq-plugin-cardbord",
  "version": "1.0.0",
  "description": "Плагин для создания интерактивных сеток с карточками в Logseq",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --external:@logseq/libs --format=iife --global-name=CardbordPlugin --loader:.css=text",
    "dev": "esbuild src/index.ts --bundle --outfile=dist/index.js --external:@logseq/libs --format=iife --global-name=CardbordPlugin --loader:.css=text --watch"
  },
  "keywords": ["logseq", "plugin", "cards", "grid", "kanban"],
  "author": "",
  "license": "MIT",
  "logseq": {
    "id": "logseq-plugin-cardbord",
    "title": "Cardbord",
    "icon": "./icon.svg"
  },
  "devDependencies": {
    "@logseq/libs": "^0.0.17",
    "esbuild": "^0.19.0",
    "typescript": "^5.0.0"
  }
}
